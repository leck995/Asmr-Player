                              <Label fx:id="text" styleClass="galgame-text" text="Label" textAlignment="CENTER" wrapText="true" />
                           </children>
                        </StackPane>
                        <ImageView fx:id="dialogImage" fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true" AnchorPane.bottomAnchor="10.0" AnchorPane.rightAnchor="0.0">
